# RPM Digital Twin Configuration Example
# Copy to .env and adjust values as needed

# Serial Connection (Arduino/RPi)
SERIAL_PORT=/dev/cu.usbserial-1410
SERIAL_BAUD=115200

# TCP Connection (Remote Devices)
TCP_HOST=192.168.1.100
TCP_PORT=5005

# Data Acquisition
SAMPLE_RATE=100.0
BUFFER_DURATION=60
FILTER_CUTOFF=10.0
FILTER_ORDER=4

# Motor Control
NEMA34_MAX_RPM=1000
NEMA23_MAX_RPM=500

# GUI
UPDATE_INTERVAL=100
THEME=dark
WINDOW_WIDTH=1600
WINDOW_HEIGHT=1000

# Data Export
EXPORT_DIRECTORY=./exports
PARAVIEW_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=rpm_digital_twin.log
