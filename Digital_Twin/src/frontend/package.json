{
  "name": "rpm-digital-twin-gui",
  "version": "1.0.0",
  "description": "Commercial-grade RPM Digital Twin GUI - Electron + React",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "author": "RPM Digital Twin Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run react-dev\" \"wait-on http://localhost:5173 && npm run electron-dev\"",
    "react-dev": "vite",
    "electron-dev": "electron .",
    "build": "npm run react-build && npm run electron-build",
    "react-build": "vite build",
    "electron-build": "tsc -p ./tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "framer-motion": "^10.16.0",
    "phosphor-react": "^1.4.0",
    "plotly.js": "^2.35.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.18.0",
    "three": "^0.158.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.158.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitest/ui": "^0.34.0",
    "concurrently": "^8.2.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.51.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.rpm-digital-twin.gui",
    "productName": "RPM Digital Twin",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.science"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
